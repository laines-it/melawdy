# Optional local overrides. docker compose up --build also works without this file.
WEB_PORT=8080
API_PORT=8081
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=melawdy
POSTGRES_USER=melawdy_app
POSTGRES_PASSWORD=melawdy_local_dev

MINIO_ROOT_USER=melawdy_local
MINIO_ROOT_PASSWORD=melawdy_local_dev_secret

# Optional local model directory; empty downloads E5 into the Hugging Face cache.
# The optional compose.ml.yml sets the corresponding container path.
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu

# Optional first-run admin bootstrap. A password must have at least 5 characters.
# An existing admin password is not changed automatically on restart.
ADMIN_EMAIL=admin@melawdy.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор
# Set true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
