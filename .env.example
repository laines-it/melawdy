# Optional local overrides. docker compose up --build also works without this file.
WEB_PORT=8080
API_PORT=8081
POSTGRES_PORT=5432

POSTGRES_DB=melawdy
POSTGRES_USER=melawdy_app
POSTGRES_PASSWORD=melawdy_local_dev


# Optional local model directory; empty downloads E5 into the Hugging Face cache.
# The optional compose.ml.yml sets the corresponding container path.
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu

# Optional first-run admin bootstrap. A password must have at least 5 characters.
# An existing admin password is not changed automatically on restart.
ADMIN_EMAIL=admin@melawdy.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор
# Set true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Set false to skip embedding indexing and use BM25 without loading the model.
EMBEDDINGS_ENABLED=true

# CLEWS demonstration: the model runs manually in Colab, not on this server.
MUSIC_CHECK_ENABLED=false
# Generate a random token with at least 32 characters; also add it to Colab Secrets.
MUSIC_CHECK_WORKER_TOKEN=
# Compose sets the container directory and mounts a dedicated volume.
MUSIC_CHECK_MAX_UPLOAD_MB=32
MUSIC_CHECK_STORAGE_MB=512
MUSIC_CHECK_MAX_JOBS=20
MUSIC_CHECK_TTL_HOURS=24
