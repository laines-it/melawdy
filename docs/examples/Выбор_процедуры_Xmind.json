    {
      "id": "trademark_registration",
      "name": "Регистрация товарного знака",
      "stage_selection": {
        "title": "Выбор этапа делопроизводства",
        "selection_type": "multiple",
        "default_selected": [
          "filing_and_formal_examination",
          "substantive_examination",
          "state_registration"
        ],
        "stages": [
          {
            "id": "filing_and_formal_examination",
            "source_number": "1",
            "name": "Подача заявки и формальная экспертиза",
            "fee": {
              "type": "formula",
              "expression": "4000 + 1000 * (classes - 1)",
              "original": "4 000 ₽ (за 1 класс) + 1 000 ₽ × (Класс МКТУ − 1)",
              "currency": "RUB"
            }
          },
          {
            "id": "substantive_examination",
            "source_number": "2",
            "name": "Экспертиза по существу",
            "fee": {
              "type": "formula",
              "expression": "13000 + 2500 * (classes - 1) + 500 * max(item_names_per_class - 10, 0)",
              "original": "13 000 ₽ (за 1 класс) + 2 500 ₽ × (Класс МКТУ − 1) + 500 ₽ × max(Количество наименований − 10, 0)",
              "currency": "RUB"
            }
          },
          {
            "id": "state_registration",
            "source_number": "3",
            "name": "Регистрация в госреестре",
            "fee": {
              "type": "formula",
              "expression": "18000 + 2000 * max(classes - 5, 0)",
              "original": "18 000 ₽ (до 5 классов) + 2 000 ₽ × max(Класс МКТУ − 5, 0)",
              "currency": "RUB"
            }
          },
          {
            "id": "paper_certificate",
            "source_number": "4",
            "name": "Выдача бумажного свидетельства",
            "fee": {
              "type": "fixed",
              "amount": 3000,
              "currency": "RUB"
            }
          },
          {
            "id": "renewal",
            "source_number": "4",
            "name": "Продление срока действия",
            "optional": true,
            "fee": {
              "type": "formula",
              "expression": "22000 + 2000 * max(classes - 5, 0)",
              "original": "22 000 ₽ (до 5 классов) + 2 000 ₽ × max(Класс МКТУ − 5, 0)",
              "currency": "RUB"
            }
          }
        ]
      },
      "application_parameters": {
        "visibility": "Появляются при выборе любого этапа",
        "fields": [
          {
            "id": "classes",
            "name": "Класс МКТУ",
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "ui": "number_input_with_stepper"
